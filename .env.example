# RTAFNC Good Deed / Telegram secure runtime template
# SAFE TO COMMIT: values must remain blank in this file.
# Copy to .env ONLY on the controlled runtime host. .env is git-ignored.

TELEGRAM_ENABLED=false
TELEGRAM_CANARY_ONLY=true

# SECRET — set only in the runtime environment. Never commit or paste into chat.
TELEGRAM_BOT_TOKEN=

# Operational configuration (not a bot secret, but keep private where possible).
TELEGRAM_CHAT_ID=

# Expected bot identity used by the read-only canary check.
TELEGRAM_EXPECTED_USERNAME=SmartAGEN_bot
